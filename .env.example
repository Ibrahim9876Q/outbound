# Dashboard: http://127.0.0.1:4320/
# For a real phone use the PC's WireGuard or hotspot IPv4 and the phone's IPv4.
PHONE_DNS_HOST=127.0.0.1
PHONE_DNS_CLIENT=127.0.0.1
# Defaults to 5354 for loopback and 53 for an adapter. Standard phone DNS uses 53.
PHONE_DNS_PORT=

# Leave blank to use Windows' configured DNS resolvers.
PHONE_UPSTREAM_DNS=
PHONE_UPSTREAM_PORT=53

# Copy this file to .env and fill the values locally. .env is gitignored.
# Generate PHONE_POLICY_KEY once with: node -p "require('node:crypto').randomBytes(32).toString('hex')"
PHONE_POLICY_KEY=
PHONE_GRANT_MINUTES=15

# Auth0 FGA store settings. Use the API URL for the region of your store.
FGA_API_URL=https://api.us1.fga.dev/
FGA_STORE_ID=
FGA_MODEL_ID=
FGA_CLIENT_ID=
FGA_CLIENT_SECRET=

# CIBA-enabled Auth0 Regular Web Application using Client Secret (Post) and RS256.
# AUTH0_DOMAIN is the tenant hostname, such as your-tenant.us.auth0.com.
# AUTH0_USER_ID is the enrolled user's Auth0 user_id, such as auth0|...
AUTH0_DOMAIN=
AUTH0_CLIENT_ID=
AUTH0_CLIENT_SECRET=
AUTH0_USER_ID=
